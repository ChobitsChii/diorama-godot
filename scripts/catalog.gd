static func normalize_type(type_id: String) -> String:
	if LEGACY_ALIASES.has(type_id):
		return LEGACY_ALIASES[type_id]
	return type_id

static func has_item(type_id: String) -> bool:
	var norm = normalize_type(type_id)
	return ITEMS.has(norm)

static func get_item(type_id: String) -> Dictionary:
	var norm = normalize_type(type_id)
	return ITEMS.get(norm, {})

static func get_items_by_category(category: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for key in ITEMS:
		var item: Dictionary = ITEMS[key]
		if item["category"] == category:
			result.append(item)
	return result

static func instantiate_item(type_id: String) -> Node3D:
	var norm = normalize_type(type_id)
	if not ITEMS.has(norm):
		push_warning("Unknown catalog item: " + type_id)
		return null
	return ProceduralModels.create_model(norm)
